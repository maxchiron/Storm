{
  "name": "storm",
  "version": "1.0.6-test.1",
  "description": "Storm — a local game library manager with a Steam-style poster wall",
  "main": "./out/main/index.js",
  "license": "MIT",
  "author": "Storm",
  "scripts": {
    "dev": "electron-vite dev",
    "preview": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "seed": "node scripts/seed-demo.mjs",
    "icon": "node scripts/gen-icon.mjs",
    "dist": "npm run build && node scripts/build-installer.mjs",
    "dist:zip": "npm run build && node scripts/fetch-koffi.mjs && electron-builder --win zip --x64",
    "dist:app": "npm run build && node scripts/fetch-koffi.mjs && electron-builder --win --x64 --dir",
    "dist:dir": "npm run build && node scripts/fetch-koffi.mjs && electron-builder --win --x64 --dir"
  },
  "dependencies": {
    "koffi": "^3.3.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^5.0.0",
    "framer-motion": "^14.7.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "zustand": "^5.0.16"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
